{% comment %}
  Custom Product Section with Live Stock Update
{% endcomment %}

<section class="product-live-stock" style="padding: 30px; border: 1px solid #eee;">
  <h2>{{ product.title }}</h2>

  <!-- Inventory Display -->
  <div id="inventory-section" style="margin-bottom: 15px;">
    <p>Total in stock: <span id="total-stock">{{ product.variants.first.inventory_quantity }}</span></p>
    <p>Remaining after cart: <span id="remaining-stock">{{ product.variants.first.inventory_quantity }}</span></p>
  </div>

  <!-- Quantity Input -->
  <label for="quantity">Quantity:</label>
  <input type="number"
         id="quantity"
         name="quantity"
         value="1"
         min="1"
         max="{{ product.variants.first.inventory_quantity }}"
         style="margin-bottom: 10px; padding: 5px;" />

  <!-- Add to Cart Button -->
  <button type="button" id="addToCartBtn" style="display: block; padding: 10px 20px; background: #000; color: #fff;">Add to Cart</button>

  <!-- JavaScript -->
  <script>
    document.addEventListener("DOMContentLoaded", function () {
      const totalStockElement = document.getElementById("total-stock");
      const remainingStockElement = document.getElementById("remaining-stock");
      const quantityInput = document.getElementById("quantity");
      const addToCartBtn = document.getElementById("addToCartBtn");

      let totalStock = parseInt(totalStockElement.innerText);

      addToCartBtn.addEventListener("click", function () {
        const qty = parseInt(quantityInput.value);

        if (qty > totalStock) {
          alert("Not enough stock available");
          return;
        }

        fetch('/cart/add.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            id: {{ product.variants.first.id }},
            quantity: qty
          })
        })
        .then(res => res.json())
        .then(data => {
          totalStock -= qty;
          totalStockElement.innerText = totalStock;
          remainingStockElement.innerText = totalStock;
          alert("Added to cart! Remaining: " + totalStock);
        })
        .catch(err => {
          console.error("Error:", err);
          alert("Something went wrong.");
        });
      });
    });
  </script>
</section>

<!-- Add this to templates/product.json -->
{
  "name": "Product",
  "sections": {
    "main": {
      "type": "main-product",
      "settings": {}
    },
    "live-stock-product": {
      "type": "live-stock-product",
      "settings": {}
    }
  },
  "order": [
    "main",
    "live-stock-product"
  ]
}
