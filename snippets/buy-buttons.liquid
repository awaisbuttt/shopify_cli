<div {{ block.shopify_attributes }}>
  {% if product != blank %}
    {% liquid
      assign gift_card_recipient_feature_active = false
      if block.settings.show_gift_card_recipient and product.gift_card?
        assign gift_card_recipient_feature_active = true
      endif

      assign show_dynamic_checkout = false
      if block.settings.show_dynamic_checkout and gift_card_recipient_feature_active == false
        assign show_dynamic_checkout = true
      endif
    %}

    <product-form
      class="product-form"
      data-hide-errors="{{ gift_card_recipient_feature_active }}"
      data-section-id="{{ section.id }}"
    >
      <div class="product-form__error-message-wrapper" role="alert" hidden>
        <span class="svg-wrapper">{{ 'icon-error.svg' | inline_asset_content }}</span>
        <span class="product-form__error-message"></span>
      </div>

      {% form 'product',
        product,
        id: product_form_id,
        class: 'form',
        novalidate: 'novalidate',
        data-type: 'add-to-cart-form'
      %}

        <input
          type="hidden"
          name="id"
          value="{{ product.selected_or_first_available_variant.id }}"
          class="product-variant-id"
          {% if product.selected_or_first_available_variant.available == false or product.selected_or_first_available_variant == null %}
            disabled
          {% endif %}
        >

        {% liquid
          assign available_qty = product.selected_or_first_available_variant.inventory_quantity
          assign check_against_inventory = true
          if product.selected_or_first_available_variant.inventory_management != 'shopify' or product.selected_or_first_available_variant.inventory_policy == 'continue'
            assign check_against_inventory = false
          endif
          if product.selected_or_first_available_variant.quantity_rule.min > available_qty and check_against_inventory
            assign quantity_rule_soldout = true
          endif
        %}

        <!-- ✅ Quantity Selector with Stock Info Below -->
        <div class="custom-quantity-wrapper">
          <label for="Quantity-{{ section.id }}">Quantity</label>
          <div class="quantity-selector">
            <button type="button" class="qty-btn minus" aria-label="Decrease quantity">−</button>
            <input
              id="Quantity-{{ section.id }}"
              type="number"
              name="quantity"
              min="1"
              value="1"
              class="quantity-input"
            >
            <button type="button" class="qty-btn plus" aria-label="Increase quantity">+</button>
          </div>

          {% if product.selected_or_first_available_variant.available == false or quantity_rule_soldout %}
            <div class="stock-message" style="color: red;">
              {{ 'products.product.sold_out' | t }}
            </div>
          {% else %}
            <div class="stock-message" style="color: green;" data-available="{{ available_qty }}">
              In stock — <span class="total-stock">{{ available_qty }}</span> available |
              <span class="remaining-stock">{{ available_qty | minus: 1 }}</span> remaining
            </div>
          {% endif %}
        </div>

        <!-- ✅ Add to Cart Button -->
        <div class="product-form__buttons">
          <button
            id="ProductSubmitButton-{{ section_id }}"
            type="submit"
            name="add"
            class="product-form__submit button button--full-width {% if show_dynamic_checkout %}button--secondary{% else %}button--primary{% endif %}"
            {% if product.selected_or_first_available_variant.available == false or quantity_rule_soldout or product.selected_or_first_available_variant == null %}
              disabled
            {% endif %}
          >
            <span>
              {% if product.selected_or_first_available_variant == null %}
                {{ 'products.product.unavailable' | t }}
              {% elsif product.selected_or_first_available_variant.available == false or quantity_rule_soldout %}
                {{ 'products.product.sold_out' | t }}
              {% else %}
                {{ 'products.product.add_to_cart' | t }}
              {% endif %}
            </span>
            {% render 'loading-spinner' %}
          </button>

          {% if show_dynamic_checkout %}
            {{ form | payment_button }}
          {% endif %}
        </div>
      {% endform %}
    </product-form>
  {% else %}
    <div class="product-form">
      <div class="product-form__buttons form">
        <button
          type="submit"
          name="add"
          class="product-form__submit button button--full-width button--primary"
          disabled
        >
          {{ 'products.product.sold_out' | t }}
        </button>
      </div>
    </div>
  {% endif %}
</div>

<!-- ✅ JavaScript: Inventory - Cart Quantity - Input Quantity -->
<script>
  document.addEventListener('DOMContentLoaded', function () {
    const wrapper = document.querySelector('.custom-quantity-wrapper');
    const input = wrapper?.querySelector('.quantity-input');
    const minus = wrapper?.querySelector('.minus');
    const plus = wrapper?.querySelector('.plus');
    const stockMessage = document.querySelector('.stock-message');
    const addToCartBtn = document.querySelector('.product-form__submit');
    const remainingEl = stockMessage?.querySelector('.remaining-stock');
    const available = parseInt(stockMessage?.dataset.available || "0");
    const variantId = document.querySelector('input.product-variant-id')?.value;

    if (!wrapper || !input || !stockMessage) return;

    let cartQty = 0;

    // 🔁 Get cart quantity of current variant
    fetch('/cart.js')
      .then(res => res.json())
      .then(cart => {
        cart.items.forEach(item => {
          if (item.id == variantId) {
            cartQty = item.quantity;
          }
        });

        updateRemaining();
      });

    function updateRemaining() {
      let selectedQty = parseInt(input.value);
      if (isNaN(selectedQty) || selectedQty < 1) selectedQty = 1;

      const remaining = available - cartQty - selectedQty;

      if (remainingEl) remainingEl.textContent = remaining >= 0 ? remaining : 0;
      input.value = selectedQty;

      // Disable Add to Cart if over available
      if (selectedQty + cartQty > available || selectedQty < 1) {
        addToCartBtn.disabled = true;
      } else {
        addToCartBtn.disabled = false;
      }
    }

    minus.addEventListener('click', function () {
      let val = parseInt(input.value);
      if (val > 1) input.value = val - 1;
      updateRemaining();
    });

    plus.addEventListener('click', function () {
      let val = parseInt(input.value);
      if ((val + cartQty) < available) input.value = val + 1;
      updateRemaining();
    });

    input.addEventListener('input', updateRemaining);
  });
</script>

<!-- ✅ Final CSS -->
<style>
  .custom-quantity-wrapper {
    margin-bottom: 1rem;
    font-family: inherit;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .quantity-selector {
    display: flex;
    align-items: center;
    border: 1px solid #666; /* ✅ Light black border */
    border-radius: 6px;
    margin-bottom: 10px; /* ✅ spacing below buttons */
    padding: 4px;
  }

  .qty-btn {
    background: #f5f5f5;
    border: none;
    font-size: 22px;
    width: 38px;
    height: 38px;
    line-height: 1;
    cursor: pointer;
    margin: 0 4px;
    border-radius: 4px;
  }

  .qty-btn:disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }

  .quantity-input {
    width: 60px;
    height: 38px;
    text-align: center;
    border: none;
    font-size: 17px;
  }

  .stock-message {
    font-size: 15px;
    margin-top: 5px;
  }
</style>
